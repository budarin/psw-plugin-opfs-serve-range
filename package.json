{
    "name": "@budarin/psw-plugin-opfs-serve-range",
    "version": "1.0.0",
    "description": "Service Worker plugin: serve HTTP Range requests from OPFS files",
    "keywords": [
        "service-worker",
        "opfs",
        "range-requests",
        "pluggable-serviceworker"
    ],
    "license": "MIT",
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "peerDependencies": {
        "@budarin/pluggable-serviceworker": "^1.9.0"
    },
    "dependencies": {
        "@budarin/http-constants": "^1.0.22"
    },
    "devDependencies": {
        "@budarin/pluggable-serviceworker": "^1.10.2",
        "@types/serviceworker": "^0.0.190",
        "@types/web": "^0.0.335",
        "typescript": "^5.9.3"
    },
    "scripts": {
        "build": "tsc",
        "clear-caches": "sh scripts/clear-caches.sh",
        "pnpm-install": "pnpm install",
        "upgrade-deps": "sh scripts/upgrade-deps.sh",
        "publish-package": "pnpm build && pnpm publish --access=public"
    }
}
